{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-documate-v3-smoke",
    "name": "Documate v3 — Smoke (Waves 0–6)",
    "description": "Smoke tests through Wave 6 External + F2 API keys (DQ-0001…0603).\n\nApp auth: DevBypass. External: X-Api-Key from POST /api/app/api-keys.\n\nStop point: before Wave 7 (OCR/classify).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5172" },
    { "key": "agentId", "value": "" },
    { "key": "documentTypeId", "value": "" },
    { "key": "queueId", "value": "" },
    { "key": "fileId", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "batchId", "value": "" },
    { "key": "allowlistEntryId", "value": "" },
    { "key": "allowlistModeEnumId", "value": "" }
  ],
  "item": [
    {
      "name": "00 — Health & ping",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "GET /api/app/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/health"
          }
        },
        {
          "name": "GET /api/app/system/ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/system/ping"
          }
        }
      ]
    },
    {
      "name": "01 — Auth / me (DevBypass)",
      "item": [
        {
          "name": "GET /api/app/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('me returns business', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.businessId).to.be.ok;",
                  "  pm.expect(j.tenantId).to.be.ok;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/me",
            "description": "Provisions CorTenant + CorTenantBusiness on first call."
          }
        }
      ]
    },
    {
      "name": "02 — Platform catalogs",
      "item": [
        {
          "name": "GET document-types",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('has document types', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.length).to.be.above(0);",
                  "  var inv = j.find(x => x.documentTypeKey === 'invoice');",
                  "  pm.expect(inv).to.be.ok;",
                  "  pm.collectionVariables.set('documentTypeId', String(inv.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/catalogs/document-types"
          }
        },
        {
          "name": "GET providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/catalogs/providers"
          }
        },
        {
          "name": "GET agent-templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/catalogs/agent-templates"
          }
        },
        {
          "name": "GET agent-template by key",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/catalogs/agent-templates/invoice_generic_v1"
          }
        }
      ]
    },
    {
      "name": "03 — Agents CRUD",
      "item": [
        {
          "name": "POST clone-from-template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('cloned agent', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.id).to.be.ok;",
                  "  pm.expect(j.sourceTemplateId).to.be.ok;",
                  "  pm.collectionVariables.set('agentId', j.id);",
                  "  pm.collectionVariables.set('documentTypeId', String(j.documentTypeId));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentTemplateKey\": \"invoice_generic_v1\",\n  \"name\": \"Smoke Invoice Agent\"\n}"
            },
            "url": "{{baseUrl}}/api/app/agents/clone-from-template"
          }
        },
        {
          "name": "GET agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/agents"
          }
        },
        {
          "name": "GET agent by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/agents/{{agentId}}"
          }
        },
        {
          "name": "PUT update agent",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoke Invoice Agent (updated)\",\n  \"description\": \"Updated in smoke\",\n  \"documentTypeId\": {{documentTypeId}},\n  \"outputSchemaJson\": \"{\\\"type\\\":\\\"object\\\"}\",\n  \"instructions\": \"Extract carefully.\",\n  \"defaultWorkflowId\": null,\n  \"defaultProviderId\": null,\n  \"schemaVersion\": 1,\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/app/agents/{{agentId}}"
          }
        },
        {
          "name": "POST create agent (manual)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manual Credit Note Agent\",\n  \"description\": null,\n  \"documentTypeId\": {{documentTypeId}},\n  \"outputSchemaJson\": \"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{}}\",\n  \"instructions\": \"Extract credit note fields.\",\n  \"defaultWorkflowId\": null,\n  \"defaultProviderId\": null,\n  \"schemaVersion\": 1\n}"
            },
            "url": "{{baseUrl}}/api/app/agents",
            "description": "Uses same documentTypeId as invoice for smoke simplicity; prefer matching type in real use."
          }
        }
      ]
    },
    {
      "name": "04 — Queues CRUD + routes + webhook + email",
      "item": [
        {
          "name": "POST create queue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('queue created', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.id).to.be.ok;",
                  "  pm.collectionVariables.set('queueId', j.id);",
                  "  pm.collectionVariables.set('allowlistModeEnumId', String(j.allowlistModeEnumId));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoke AP Inbox\",\n  \"description\": \"Multi-queue smoke\"\n}"
            },
            "url": "{{baseUrl}}/api/app/queues"
          }
        },
        {
          "name": "POST create second queue",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoke DN Inbox\",\n  \"description\": \"Second queue same Business\"\n}"
            },
            "url": "{{baseUrl}}/api/app/queues"
          }
        },
        {
          "name": "GET list queues",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues"
          }
        },
        {
          "name": "GET queue detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}"
          }
        },
        {
          "name": "PUT update queue",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoke AP Inbox (updated)\",\n  \"description\": \"Updated\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}"
          }
        },
        {
          "name": "PUT replace routes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('route saved', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.length).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routes\": [\n    {\n      \"documentTypeId\": {{documentTypeId}},\n      \"agentId\": \"{{agentId}}\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/routes"
          }
        },
        {
          "name": "GET routes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/routes"
          }
        },
        {
          "name": "PUT webhook settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"url\": \"https://example.com/documate/webhook\",\n  \"secret\": \"smoke-webhook-secret\"\n}"
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/webhook"
          }
        },
        {
          "name": "POST mint email address",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/email/mint"
          }
        },
        {
          "name": "PUT email settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailIntakeEnabled\": true,\n  \"allowlistModeEnumId\": {{allowlistModeEnumId}}\n}"
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/email"
          }
        },
        {
          "name": "POST allowlist entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('allowlist created', function () {",
                  "  var j = pm.response.json();",
                  "  pm.collectionVariables.set('allowlistEntryId', String(j.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchTypeKey\": \"domain\",\n  \"value\": \"partner.example\"\n}"
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/allowlist"
          }
        },
        {
          "name": "GET allowlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/allowlist"
          }
        },
        {
          "name": "POST lock routing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('routing locked', function () {",
                  "  pm.expect(pm.response.json().routingLocked).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/routing/lock",
            "description": "Simulates first-File lock for smoke before File pipeline exists."
          }
        },
        {
          "name": "PUT routes after lock (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('conflict when locked', function () {",
                  "  pm.expect(pm.response.code).to.eql(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routes\": []\n}"
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/routes"
          }
        },
        {
          "name": "DELETE allowlist entry",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/allowlist/{{allowlistEntryId}}"
          }
        }
      ]
    },
    {
      "name": "05 — Files / storage (Wave 4)",
      "item": [
        {
          "name": "POST upload file",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('file created', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.id).to.be.ok;",
                  "  pm.expect(j.storageKey).to.match(/^tenants\\/\\d+\\/businesses\\/\\d+\\/queues\\/\\d+\\/files\\/\\d+\\//);",
                  "  pm.collectionVariables.set('fileId', String(j.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick any small text/PDF in Postman before send."
                },
                {
                  "key": "documentTypeKey",
                  "type": "text",
                  "value": "invoice",
                  "description": "Optional. When set, skip split/classify and route this type (set QueueRoute first)."
                }
              ]
            },
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files",
            "description": "Persists OpsFile + blob + WorkEvent. Optional documentTypeKey skips split/classify. Locks queue routing on first file — PUT routes before this."
          }
        },
        {
          "name": "GET file",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('file get', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('fileId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files/{{fileId}}"
          }
        },
        {
          "name": "GET download-url",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('signed or local url', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(pm.response.json().url).to.be.ok;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files/{{fileId}}/download-url"
          }
        },
        {
          "name": "GET file until ready (Wave 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('pipeline reached ready or still processing', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(['received','processing','ready']).to.include(j.publicStatusKey);",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().publicStatusKey !== 'ready') {",
                  "  setTimeout(function () {}, 200);",
                  "  // Re-run this request manually / in Collection Runner with delay until publicStatusKey=ready",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files/{{fileId}}",
            "description": "Stub pipeline (DQ-0501) advances received → processing → ready. Poll until publicStatusKey is ready."
          }
        }
      ]
    },
    {
      "name": "06 — External + F2 API keys (Wave 6)",
      "item": [
        {
          "name": "POST create api-key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('api key created once', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.apiKey).to.match(/^dm_/);",
                  "  pm.collectionVariables.set('apiKey', j.apiKey);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"postman-partner\"\n}" },
            "url": "{{baseUrl}}/api/app/api-keys",
            "description": "F2 temporary bridge. Raw apiKey shown once."
          }
        },
        {
          "name": "POST external multi-file upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 accepted', function () {",
                  "  pm.expect(pm.response.code).to.eql(202);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.fileIds.length).to.be.above(0);",
                  "  pm.collectionVariables.set('fileId', String(j.fileIds[0]));",
                  "  if (j.batchId) pm.collectionVariables.set('batchId', String(j.batchId));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [], "description": "Add 2+ files with key files" },
                { "key": "files", "type": "file", "src": [], "disabled": true },
                { "key": "documentTypeKey", "type": "text", "value": "invoice", "description": "Optional. When set, skip split/classify and route this type." },
                { "key": "documentCount", "type": "text", "value": "1", "disabled": true }
              ]
            },
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/files"
          }
        },
        {
          "name": "GET external list files",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/files"
          }
        },
        {
          "name": "GET external file",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/files/{{fileId}}"
          }
        },
        {
          "name": "GET external documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/documents?fileId={{fileId}}",
            "description": "When ready: resultJson is the Agent schema payload. Failed docs include errorCode (no_agent, schema_invalid, extract_failed, unroutable_type)."
          }
        }
      ]
    },
    {
      "name": "99 — Cleanup (optional)",
      "item": [
        {
          "name": "DELETE agent",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/app/agents/{{agentId}}"
          }
        },
        {
          "name": "DELETE queue",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}"
          }
        }
      ]
    }
  ]
}
