    {
      "name": "07 \u2014 External async (X-Api-Key)",
      "item": [
        {
          "name": "POST external multi-file upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/files",
            "description": "Form field name is `files` (repeat for 2+ files). Optional documentTypeKey.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Add 1+ files with key files"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "disabled": true
                },
                {
                  "key": "documentTypeKey",
                  "type": "text",
                  "value": "invoice"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 accepted', function () {",
                  "  pm.expect(pm.response.code).to.eql(202);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.fileIds.length).to.be.above(0);",
                  "  pm.collectionVariables.set('fileId', String(j.fileIds[0]));",
                  "  if (j.batchId) pm.collectionVariables.set('batchId', String(j.batchId));",
                  "  pm.collectionVariables.set('filePollTries', '0');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET external list files",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/files"
          }
        },
        {
          "name": "GET external file",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/files/{{fileId}}"
          }
        },
        {
          "name": "GET external documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/documents?fileId={{fileId}}",
            "description": "Poll until publicStatusKey is ready/failed. resultJson holds extract payload."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 list', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "var docs = pm.response.json();",
                  "if (Array.isArray(docs) && docs.length) {",
                  "  pm.collectionVariables.set('documentId', String(docs[0].id));",
                  "  var n = Number(pm.collectionVariables.get('filePollTries') || 0);",
                  "  var st = docs[0].publicStatusKey;",
                  "  var done = ['ready','failed','rejected','cancelled'].indexOf(st) >= 0;",
                  "  if (!done && n < 40) {",
                  "    pm.collectionVariables.set('filePollTries', String(n + 1));",
                  "    postman.setNextRequest('GET external documents');",
                  "  } else {",
                  "    pm.collectionVariables.set('filePollTries', '0');",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET external document by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          }
        }
      ]
    },
    {
      "name": "08 \u2014 External sync extract",
      "item": [
        {
          "name": "POST sync extract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/queues/{{queueId}}/extract",
            "description": "Single file. HTTP waits up to 60s. No webhook (C2). Attach invoice-sample.txt. Client timeout > 60s.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Attach docs/postman/samples/invoice-sample.txt"
                },
                {
                  "key": "documentTypeKey",
                  "type": "text",
                  "value": "invoice"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sync extract 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.fileId).to.be.ok;",
                  "  pm.collectionVariables.set('fileId', String(j.fileId));",
                  "  if (j.documentIds && j.documentIds.length) {",
                  "    pm.collectionVariables.set('documentId', String(j.documentIds[0]));",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
