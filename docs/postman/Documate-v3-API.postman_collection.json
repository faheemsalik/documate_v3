            "description": "Attach samples/invoice-sample.txt. documentTypeKey skips split/classify.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Attach docs/postman/samples/invoice-sample.txt"
                },
                {
                  "key": "documentTypeKey",
                  "type": "text",
                  "value": "invoice"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('file created', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.id).to.be.ok;",
                  "  pm.collectionVariables.set('fileId', String(j.id));",
                  "  pm.collectionVariables.set('filePollTries', '0');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET file",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files/{{fileId}}"
          }
        },
        {
          "name": "GET download-url",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files/{{fileId}}/download-url"
          }
        },
        {
          "name": "GET file (poll until ready)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/app/queues/{{queueId}}/files/{{fileId}}",
            "description": "Collection Runner loops until ready/failed (max ~40)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "var n = Number(pm.collectionVariables.get('filePollTries') || 0);",
                  "var done = ['ready','failed','partial_ready'].indexOf(j.publicStatusKey) >= 0;",
                  "if (!done && n < 40) {",
                  "  pm.collectionVariables.set('filePollTries', String(n + 1));",
                  "  postman.setNextRequest('GET file (poll until ready)');",
                  "} else {",
                  "  pm.collectionVariables.set('filePollTries', '0');",
                  "  pm.test('file reached a terminal status', function () {",
                  "    pm.expect(['ready','failed','partial_ready']).to.include(j.publicStatusKey);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
