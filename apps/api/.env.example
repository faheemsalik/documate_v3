# Copy to user-secrets or environment — do not commit real values.
# ASP.NET: dotnet user-secrets set "Llm:Providers:gpt_5_6:ApiKey" "..."
# Env: Llm__Providers__gpt_5_6__ApiKey=...

ConnectionStrings__Documate=

# Storage: Provider=local (dev) | s3 (old_code AWS path). Prefer IAM role in AWS over keys.
Storage__Provider=local
Storage__BucketOrContainer=documate
Storage__Region=us-west-2
Storage__SignedUrlMinutes=30
Storage__ServiceUrl=
Storage__AccessKey=
Storage__SecretKey=

# OCR (DQ-0704)
Ocr__Textract__Region=us-west-2
Ocr__Textract__AccessKey=
Ocr__Textract__SecretKey=
Ocr__GoogleDocumentAi__ProjectId=
Ocr__GoogleDocumentAi__Location=us
Ocr__GoogleDocumentAi__ProcessorId=
# Prefer GOOGLE_APPLICATION_CREDENTIALS; optional inline JSON:
# Ocr__GoogleDocumentAi__CredentialsJson=

# LLM required in all environments (startup gate)
Llm__DefaultProviderKey=gpt_5_6
Llm__Providers__gpt_5_6__ApiKey=
Llm__Providers__gpt_5_6__Model=gpt-5.6
Llm__Providers__claude_sonnet_6__ApiKey=
Llm__Providers__claude_sonnet_6__Model=claude-sonnet-4-6

# Ops alert on LLM fail (DR1-B) — SMTP only when Enabled=true
Notifications__Enabled=false
Notifications__ToAddress=faheem@manticsoftware.com
Notifications__Smtp__Host=
Notifications__Smtp__Port=587
Notifications__Smtp__User=
Notifications__Smtp__Password=
Notifications__Smtp__From=

# Legacy placeholders (kept for compatibility; prefer Llm: / Ocr:)
Providers__DocumateMetaApiKey=
Providers__DefaultLlmApiKey=
Providers__DefaultOcrApiKey=
