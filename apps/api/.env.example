# Copy to environment only for SM *bootstrap* (calling GetSecretValue) — not for app secrets.
# App secrets: AWS Secrets Manager (Plan 17). Ops non-secrets: CorSystemSetting / admin UI (Plan 15).
#
# Infisical is the documented backup vault (not wired) — see docs/plans/17-platform-secrets-store.md

SecretsManager__Enabled=true
SecretsManager__SecretId=documate/dev/api
SecretsManager__Region=us-east-1

# Bootstrap only (optional if ~/.aws/credentials is configured):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

ConnectionStrings__Documate=

# LLM model *names* (ApiKey comes from SM). Provider selection for pipeline is in DB settings.
Llm__DefaultProviderKey=gpt_5_6
Llm__Providers__gpt_5_6__Model=gpt-5.6
Llm__Providers__claude_sonnet_6__Model=claude-sonnet-4-6
