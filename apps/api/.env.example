# Copy to user-secrets or environment — do not commit real values.
# ASP.NET: dotnet user-secrets set "Providers:DefaultLlmApiKey" "..."
# Env: Providers__DefaultLlmApiKey=...

ConnectionStrings__Documate=

# Storage: Provider=local (dev) | s3 (old_code AWS path). Prefer IAM role in AWS over keys.
Storage__Provider=local
Storage__BucketOrContainer=documate
Storage__Region=us-west-2
Storage__SignedUrlMinutes=30
Storage__ServiceUrl=
Storage__AccessKey=
Storage__SecretKey=

Providers__DocumateMetaApiKey=
Providers__DefaultLlmApiKey=
Providers__DefaultOcrApiKey=
