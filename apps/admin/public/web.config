<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS SPA fallback for Angular (no URL Rewrite module required).
  Copy this file to the IIS site root next to index.html.
  If the site returns 500.19 after copying, on the IIS server run:
    %windir%\system32\inetsrv\appcmd unlock config /section:system.webServer/httpErrors
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" prefixLanguageFilePath="" path="index.html" responseMode="File" />
    </httpErrors>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
