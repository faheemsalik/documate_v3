<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the Angular SPA.
  Direct URLs and refreshes (e.g. /dashboard) must serve index.html so the
  Angular router can handle them.

  Deploy this file at the IIS site root next to index.html
  (apps/admin/dist/admin/browser). URL Rewrite is preferred. httpErrors covers
  cases where a rewrite rule does not run (extensionless paths are treated
  as directories). If the site fails to start with 500.19 on &lt;rewrite&gt;,
  install IIS URL Rewrite, or remove the rewrite block and keep httpErrors.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Angular SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api)(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="\.(?:css|js|mjs|map|json|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|txt)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
