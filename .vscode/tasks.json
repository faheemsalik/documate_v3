{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Documate.slnx",
        "-c",
        "Debug",
        "--nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "test-api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/api/Documate.Api.Tests.csproj",
        "--nologo",
        "-v",
        "minimal"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "run-api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/apps/api/Documate.Api.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-run",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:|Application started\\.|listening on http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "api"
      }
    },
    {
      "label": "watch-api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/apps/api/Documate.Api.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-watch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:|Application started\\.|listening on http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "api"
      }
    },
    {
      "label": "build-web",
      "type": "npm",
      "script": "build",
      "path": "apps/web",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "run-web",
      "type": "npm",
      "script": "start",
      "path": "apps/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "."
          },
          "endsPattern": {
            "regexp": "(Local:|Local:\\s+http|Application bundle generation complete|Compiled successfully|watching for file changes)"
          }
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "web"
      }
    },
    {
      "label": "script: build",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/build.ps1\"",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "script: run-api",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/run-api.ps1\"",
      "isBackground": true,
      "problemMatcher": {
        "owner": "script-run-api",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:|Application started\\.|listening on http"
        }
      }
    },
    {
      "label": "script: run-web",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/run-web.ps1\"",
      "isBackground": true,
      "problemMatcher": {
        "owner": "script-run-web",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|Application bundle generation complete|Compiled successfully)"
        }
      }
    }
  ]
}
